ADMIN_BOT_TOKEN=paste-token-from-BotFather
CRM_BOT_TOKEN=paste-second-token-from-BotFather
ADMIN_USER_ID=paste-your-telegram-user-id
# Turso shows this as libsql://...; https:// is the same host over the HTTP
# API, which is the transport that works. Either form is accepted.
TURSO_DATABASE_URL=https://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=paste-token-from-turso
DASHBOARD_KEY=make-up-a-long-random-word
# Two-letter country the upload form starts on, and the one the admin bot
# reads local-looking numbers as. GB when this is not set.
DEFAULT_COUNTRY=GB
# Where the dashboard listens. The defaults are right on a laptop and on a server.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
